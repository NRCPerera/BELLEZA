NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
SLOW_QUERY_MS=100
LOG_LEVEL=info
# Generate at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-64-character-random-secret-before-starting

# Comma-separated browser origins allowed to call this API.
CLIENT_URL=http://localhost:5173
# Optional. Leave blank for a host-only cookie (recommended when using separate
# Render onrender.com hostnames). Use .example.com for www.example.com + api.example.com.
COOKIE_DOMAIN=
# Production defaults to none for a cross-site SPA/API; development defaults to lax.
COOKIE_SAME_SITE=

# Resend email service (booking confirmations + status updates)
# Get key: https://resend.com/api-keys — EMAIL_FROM must be a verified sender/domain
RESEND_API_KEY=
EMAIL_FROM=Belleza <bookings@example.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development-only destructive seed guard. Never set these in Render.
ALLOW_SEED=false
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PRIYANANDA_PASSWORD=
SEED_SASANKA_PASSWORD=
