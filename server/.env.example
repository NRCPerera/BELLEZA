NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret

# Comma-separated browser origins allowed to call this API.
CLIENT_URL=http://localhost:5173
# Production: .example.com allows www.example.com to call api.example.com.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Resend HTTPS API (preferred)
RESEND_API_KEY=
EMAIL_FROM=Salon <bookings@example.com>

# Optional SMTP fallback (leave blank when using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development-only destructive seed guard. Never set these in Render.
ALLOW_SEED=false
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
